  "metric": {
    "_notes": "Non-color, non-typographic metrics consumed by both platforms. Today this is just the Re-Leaf paper-saved math: each capture kind is rated against what it would have replaced on paper, and a mature pine is held at 8,333 letter-size sheets. iOS emits AppMetrics.generated.swift, Android emits AppMetrics.generated.kt. Edit values here, regenerate, both platforms move together.",
    "paperPerCapture": {
      "scan": {
        "value": 1.0,
        "type": "number",
        "description": "One scan replaces one printed page."
      },
      "note": {
        "value": 0.3,
        "type": "number",
        "description": "Per Note row \u2014 roughly a quarter-page of writing each."
      },
      "voice": {
        "value": 0.1,
        "type": "number",
        "description": "A voice memo replaces a tenth of a sheet of dictation."
      },
      "contact": {
        "value": 0.1,
        "type": "number",
        "description": "A captured contact replaces a business card."
      },
      "place": {
        "value": 0.05,
        "type": "number",
        "description": "A pinned place replaces a sliver of a printed map / address slip."
      },
      "photo": {
        "value": 0.05,
        "type": "number",
        "description": "A captured photo replaces a small printed reference image."
      },
      "todo": {
        "value": 0.05,
        "type": "number",
        "description": "A todo replaces a sticky-note's worth of paper."
      }
    },
    "sheetsPerTree": {
      "value": 8333,
      "type": "number",
      "description": "Letter-size sheets a mature pine yields. Used to convert sheets saved into a tree-fraction for the FOREST tile and the paper-saved detail sheet."
    }
  }
