# ─── macOS ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# ─── iOS / Xcode / SwiftPM ──────────────────────────────
xcuserdata/
*.xcuserstate
DerivedData/
.build/
Packages/
Package.resolved
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
.swiftpm/

# Secrets — signing, API keys, Google OAuth client IDs
GoogleService-Info.plist
Releaf.entitlements
*.pem
*.p12
*.cer

# ─── Android / Gradle ───────────────────────────────────
.gradle/
build/
local.properties
*.iml
.idea/
captures/
.cxx/

# Google services JSON — do not commit real creds
google-services.json

# Android release-signing secrets — keystores + props files. The
# keystore.properties pattern is read by app/build.gradle.kts to
# wire the upload key for AAB signing; never check in either the
# props file or the keystore itself.
*.jks
*.keystore
keystore.properties

# ─── Tooling ────────────────────────────────────────────
.vscode/
.fleet/
node_modules/

# Claude Code per-project state — agent worktrees, transcripts,
# plan files. Lives next to the repo it operates on and is
# personal to whoever ran the agent. Never tracked.
.claude/

# ─── Misc ───────────────────────────────────────────────
*.log
*.tmp
*.swp
