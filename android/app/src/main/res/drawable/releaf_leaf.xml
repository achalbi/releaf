<!--
  Canonical Releaf leaf mark. Path data is the authoritative SVG from
  the Releaf Branding spec (24-unit viewBox). Three layers:
    1. Green gradient fill
    2. Cream (#F5EEDF) outline — this is the brand stroke
    3. S-curve vein in cream at 40% alpha
  Callers can tint individual layers via `android:fillColor` overrides
  in a `<layer-list>` wrapper when they need a monochrome variant.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Leaf body — gradient green fill + subtle deep-green hairline -->
    <path
        android:pathData="M12,3 C12,3 6,6 6,12 C6,15.5 8,18.5 11,20 C11.5,20.2 12,20.5 12,21 C12,20.5 12.5,20.2 13,20 C16,18.5 18,15.5 18,12 C18,6 12,3 12,3 Z"
        android:strokeColor="#5B8C52"
        android:strokeWidth="0.5"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12"
                android:startY="3"
                android:endX="12"
                android:endY="21"
                android:startColor="#7AA874"
                android:endColor="#5B8C52" />
        </aapt:attr>
    </path>
    <!-- Cream brand outline on top -->
    <path
        android:pathData="M12,3 C12,3 6,6 6,12 C6,15.5 8,18.5 11,20 C11.5,20.2 12,20.5 12,21 C12,20.5 12.5,20.2 13,20 C16,18.5 18,15.5 18,12 C18,6 12,3 12,3 Z"
        android:strokeColor="#F5EEDF"
        android:strokeWidth="1.2"
        android:strokeLineJoin="round" />
    <!-- Vein S-curve at 40% alpha -->
    <path
        android:pathData="M12,6 C12,6 14,8.5 14,11.5 C14,13.5 13,15 12,16"
        android:strokeColor="#66F5EEDF"
        android:strokeWidth="0.8"
        android:strokeLineCap="round" />
</vector>
