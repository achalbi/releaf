<!--
  Adaptive launcher background. Theme-green primary (design-tokens.json →
  color.theme.green.primary #7AA874) with a subtle diagonal lighter tint
  top-left, matching the PDF branding spec's "Main App Icon".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#8CB786"
                android:endColor="#6A9864" />
        </aapt:attr>
    </path>
</vector>
