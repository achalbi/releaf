<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Page editor LOCATION section. Coarse is fine — we only need city/address
         granularity for reverse geocoding; fine is the richer request the user
         sees. Declaring both lets us downgrade at runtime if the user picks
         "approximate only" on API 31+. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Editor VOICE section. Required for MediaRecorder to capture audio;
         user grants the runtime permission on first record tap. No foreground
         service needed today since recording only happens while the editor
         surface is visible. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Contacts screen. Required to surface device contacts alongside
         the in-app contact directory when the user types in the search
         field. Runtime-granted on first search attempt; the screen
         shows an "Enable device contacts" CTA while permission is
         missing. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Reminders feature. Need POST_NOTIFICATIONS runtime-granted on API 33+
         to post the alarm notification, SCHEDULE_EXACT_ALARM on API 31+ so the
         ReminderScheduler can wake the device at the user's chosen time, and
         RECEIVE_BOOT_COMPLETED so ReminderBootReceiver can re-register pending
         alarms after a reboot (AlarmManager clears the queue on shutdown). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- API 30+ package visibility. SpeechRecognizer needs to resolve a
         RecognitionService on the device (usually Google's, shipped via
         Play Services) and the platform won't expose that service to us
         without an explicit <queries> declaration. Without this block
         `createSpeechRecognizer` returns a client that silently fails to
         start on stock Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ReleafApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Releaf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Releaf.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          FileProvider for the camera-capture path in PhotosSection.
          We prepare an output file in our attachments dir, hand the
          camera app a content:// URI pointing at it, and read the
          resulting JPEG back as a file:// URI once capture completes.
          `exported=false` is required; `grantUriPermissions=true` lets
          us grant the camera app a temporary write permission on the
          URI we pass to TakePicture.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Reminders — alarm fire receiver. Not exported; only the OS
          AlarmManager calls it via PendingIntent, so no external
          broadcast needs to reach it.
        -->
        <receiver
            android:name="app.releaf.mobile.data.reminder.ReminderAlarmReceiver"
            android:exported="false" />

        <!--
          Reminders — boot receiver. Exported so it receives
          BOOT_COMPLETED + MY_PACKAGE_REPLACED from the OS (implicit
          broadcasts from a privileged sender — we still scope it to
          those actions in the intent-filter).
        -->
        <receiver
            android:name="app.releaf.mobile.data.reminder.ReminderBootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
