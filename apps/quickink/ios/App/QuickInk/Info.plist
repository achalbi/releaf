<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.quickink.mobile.sync</string>
		<!--
		  Analytics outbox flush. Registered + scheduled by
		  AnalyticsFlushTask.install(...) at app launch. The
		  identifier MUST match `AnalyticsFlushTask.identifier`
		  in code or BGTaskScheduler.register traps. Re-running
		  every ~30 min is the ask; iOS budgets the actual
		  cadence based on usage patterns.
		-->
		<string>app.quickink.analytics.flush</string>
	</array>
	<!--
	  Feature flag the AnalyticsFlushTask reads at every entry
	  point (install / requestImmediate / scheduleNext). When false
	  or missing, the task does nothing — the on-disk outbox is
	  left untouched, so flipping the flag back on later picks up
	  wherever it stopped.
	-->
	<key>AnalyticsEnabled</key>
	<true/>
	<!--
	  Root URL the AnalyticsApiClient appends `/v1/identify` and
	  `/v1/events/capture/batch` to. Live at the QuickInk backend
	  (Cloud Run + custom domain). Mirror of Android's
	  BuildConfig.ANALYTICS_BASE_URL — when one moves, both move.
	-->
	<key>AnalyticsBaseURL</key>
	<string>https://api-quickink.thoughtbasics.com</string>
	<!--
	  Camera-permission rationale. iOS shows this string the
	  first time camera access is requested; the system uses
	  one string for all access prompts, so it has to cover
	  every feature that touches the camera:
	    - profile-photo "Take Photo" flow (Profile screen)
	    - Business Card capture mode on QuickCaptureScreen (the
	      in-app AVCaptureSession surface for the card-shaped
	      auto-capture flow)
	  Document mode uses VisionKit's
	  VNDocumentCameraViewController, which handles its own
	  permission prompt internally — we don't need to mention
	  it here.
	-->
	<key>NSCameraUsageDescription</key>
	<string>QuickInk uses the camera to scan business cards in-frame and to let you take a fresh profile photo without leaving the app.</string>
	<key>CFBundleGetInfoString</key>
	<string></string>
	<!--
	  Google Sign-In iOS SDK reads `GIDClientID` directly from the
	  main bundle's Info.plist (see ReleafCore's GoogleSignInBinding.swift,
	  which calls Bundle.main.object(forInfoDictionaryKey: "GIDClientID")).
	  The reverse-DNS form of this same client ID becomes the OAuth
	  callback URL scheme listed under CFBundleURLTypes below — that's
	  how Google's auth flow round-trips back into the app.
	  Bundle ID `app.quickink.mobile` is registered against this client
	  in the Google Cloud Console.
	-->
	<key>GIDClientID</key>
	<string>534102618638-35h9gccgimo7su5utla0i8ocpq3i717v.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.quickink.mobile.googlesignin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.534102618638-35h9gccgimo7su5utla0i8ocpq3i717v</string>
			</array>
		</dict>
	</array>
	<!--
	  iOS 13+ launch-screen dict — declarative replacement for the
	  legacy LaunchScreen.storyboard. Mirrors Android's
	  `Theme.QuickInk.Splash` (cream window background + centered
	  calligraphic Q): the system shows this between the launcher
	  tap and the SwiftUI app's first frame, so it's the user's
	  first visual of the app and needs to feel branded, not blank.
	  Without these keys iOS falls back to a plain white/black
	  screen.

	  - UIColorName     references `QuickInkSplashBackground` color
	                    asset in Assets.xcassets (cream in light,
	                    near-black in dark).
	  - UIImageName     references `QuickInkSplashMark.imageset` —
	                    same brand mark Android shows on its splash.
	                    Image is sized at @1x/@2x/@3x (240/480/720
	                    px) so it renders at ~240pt. Source is
	                    `apps/quickink/design/exports/quickink-mark-
	                    1024.png` so the @3x asset stays crisp
	                    (downscale, never upscale).
	  - UIImageRespectsSafeAreaInsets defaults to true and is left
	    unset so the system centers the image cleanly within the
	    safe area on every device size.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>QuickInkSplashBackground</string>
		<key>UIImageName</key>
		<string>QuickInkSplashMark</string>
	</dict>
</dict>
</plist>
