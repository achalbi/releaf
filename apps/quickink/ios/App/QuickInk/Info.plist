<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.quickink.mobile.sync</string>
	</array>
	<!--
	  Required for the profile-photo "Take Photo" flow on the
	  Profile screen. The system shows this string in the camera-
	  permission prompt the first time the user opts to capture a
	  fresh profile photo (rather than picking from their library).
	-->
	<key>NSCameraUsageDescription</key>
	<string>QuickInk uses the camera so you can take a fresh profile photo without leaving the app.</string>
	<key>CFBundleGetInfoString</key>
	<string></string>
	<!--
	  Google Sign-In iOS SDK reads `GIDClientID` directly from the
	  main bundle's Info.plist (see ReleafCore's GoogleSignInBinding.swift,
	  which calls Bundle.main.object(forInfoDictionaryKey: "GIDClientID")).
	  The reverse-DNS form of this same client ID becomes the OAuth
	  callback URL scheme listed under CFBundleURLTypes below — that's
	  how Google's auth flow round-trips back into the app.
	  Bundle ID `app.quickink.mobile` is registered against this client
	  in the Google Cloud Console.
	-->
	<key>GIDClientID</key>
	<string>534102618638-35h9gccgimo7su5utla0i8ocpq3i717v.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.quickink.mobile.googlesignin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.534102618638-35h9gccgimo7su5utla0i8ocpq3i717v</string>
			</array>
		</dict>
	</array>
	<!--
	  iOS 13+ launch-screen dict — declarative replacement for the
	  legacy LaunchScreen.storyboard. Mirrors Android's
	  `Theme.QuickInk.Splash` (cream window background + centered
	  calligraphic Q): the system shows this between the launcher
	  tap and the SwiftUI app's first frame, so it's the user's
	  first visual of the app and needs to feel branded, not blank.
	  Without these keys iOS falls back to a plain white/black
	  screen.

	  - UIColorName     references `QuickInkSplashBackground` color
	                    asset in Assets.xcassets (cream in light,
	                    near-black in dark).
	  - UIImageName     references `QuickInkSplashMark.imageset` —
	                    same brand mark Android shows on its splash.
	                    Image is sized at @1x/@2x/@3x (240/480/720
	                    px) so it renders at ~240pt. Source is
	                    `apps/quickink/design/exports/quickink-mark-
	                    1024.png` so the @3x asset stays crisp
	                    (downscale, never upscale).
	  - UIImageRespectsSafeAreaInsets defaults to true and is left
	    unset so the system centers the image cleanly within the
	    safe area on every device size.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>QuickInkSplashBackground</string>
		<key>UIImageName</key>
		<string>QuickInkSplashMark</string>
	</dict>
</dict>
</plist>
