<?xml version="1.0" encoding="utf-8"?>
<!--
  QuickInk Android manifest.

  Permissions:
   - INTERNET: Drive REST traffic + the ML Kit module download.
   - CAMERA:   the Business Card capture mode runs an in-app
               CameraX preview (the document scanner still runs
               in GMS, but the card surface is in-process).
               Requested at runtime when the user first opens the
               Business Card mode on QuickCaptureScreen; falls
               through to a permission-rationale view in-screen.
   - ACCESS_COARSE_LOCATION: scan + import flows attach the city /
               area to each capture so Details can render the Area
               and City rows. Coarse is sufficient — we only need
               sub-locality / locality precision, not GPS-level
               accuracy — and skips the GPS warm-up delay. Asked
               for during the onboarding "Where in the world?" step
               and gated by the Settings "Attach location to scans"
               toggle.
  Sync runs as a WorkManager periodic worker, not a foreground
  service, so POST_NOTIFICATIONS is not required.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Camera is required for the in-app Business Card surface AND
      for the system document scanner (the latter runs in GMS,
      but `uses-feature` covers both). `required="false"` keeps
      the app installable on cameraless tablets where users can
      still view and edit synced scans plus use Document mode
      via the Import path.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".QuickInkApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.QuickInk"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.QuickInk.Splash"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Share-target intents — surface QuickInk in the system
              share sheet for images and PDFs. Sharing flows through
              the same `buildImportArtifacts` / `buildPdfImportArtifact`
              path as the in-app Import button: each picked file is
              copied into AttachmentStorage, OCR runs, and the
              resulting capture is tagged `source = "import"` so the
              Library card renders the Import pill.

              `singleTask` (above) keeps share invocations from
              spawning a duplicate MainActivity over an existing one;
              `onNewIntent` consumes the share when the activity is
              already alive.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
          FileProvider used by the profile-photo "Take Photo" flow.
          The camera intent (`ActivityResultContracts.TakePicture`)
          needs a content:// URI it can write to; this provider
          exposes a single cache-path entry (`@xml/file_paths`) rooted
          at the app's cacheDir/camera/ directory. Authority is the
          applicationId + ".fileprovider" so a future debug/release
          variant gets a unique authority automatically.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
